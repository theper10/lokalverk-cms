{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Editable website pages such as Home, About and Services"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "pageName": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "heading": {
      "type": "string",
      "required": true
    },
    "introText": {
      "type": "text",
      "required": true
    },
    "bodyText": {
      "type": "richtext",
      "required": true
    },
    "buttonText": {
      "type": "string"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "sortOrder": {
      "type": "integer",
      "required": true,
      "default": 0
    }
  }
}
