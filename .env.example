# Public URL and port handled by Nginx
PUBLIC_PORT=8080
PUBLIC_URL=http://localhost:8080

# PostgreSQL
DATABASE_NAME=lokalverk
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-me-local-postgres-password

# Strapi application secrets for local/test use.
# Replace these in a real deployment. Do not commit real production secrets.
APP_KEYS=change-me-app-key-a,change-me-app-key-b
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
JWT_SECRET=change-me-users-permissions-jwt-secret

# Test admin user created automatically on first startup
ADMIN_EMAIL=admin@lokalverk.test
ADMIN_PASSWORD=Admin123!
